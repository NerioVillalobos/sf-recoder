{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recorded Steps",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["action", "selector"],
    "properties": {
      "action": {
        "type": "string",
        "enum": ["click", "type", "wait"]
      },
      "selector": {
        "$ref": "#/definitions/selector"
      },
      "value": {
        "type": "string"
      },
      "delay": {
        "type": "integer",
        "minimum": 0
      },
      "waitFor": {
        "$ref": "#/definitions/waitFor"
      }
    },
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {"action": {"const": "type"}}
        },
        "then": {
          "required": ["value"]
        }
      },
      {
        "if": {
          "properties": {"action": {"const": "wait"}}
        },
        "then": {
          "required": ["waitFor"],
          "properties": {
            "selector": false
          }
        }
      }
    ]
  },
  "definitions": {
    "selector": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["label", "text", "dataTestId", "css", "xpath", "role"]
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "waitFor": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["short", "medium", "long"]
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
