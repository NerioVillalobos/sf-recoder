{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recorded Steps",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number"
        },
        "meta": {
          "type": "object",
          "additionalProperties": true
        },
        "start": {
          "type": "object",
          "properties": {
            "retURL": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Step"
          }
        }
      },
      "required": ["steps"],
      "additionalProperties": false
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Step"
      }
    }
  ],
  "definitions": {
    "Step": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["click", "type", "wait"]
        },
        "selector": {
          "$ref": "#/definitions/Selector"
        },
        "value": {
          "type": "string"
        },
        "delay": {
          "type": "number"
        },
        "waitFor": {
          "$ref": "#/definitions/WaitFor"
        },
        "ms": {
          "type": "number"
        },
        "timestamp": {
          "type": "number"
        }
      },
      "required": ["action"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": ["click", "type"]
              }
            }
          },
          "then": {
            "required": ["selector"]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "type"
              }
            }
          },
          "then": {
            "required": ["value"]
          }
        }
      ]
    },
    "WaitFor": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["networkidle", "short", "dom"]
        },
        "selector": {
          "$ref": "#/definitions/Selector"
        }
      },
      "additionalProperties": false
    },
    "Selector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "dataTestId"
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "css"
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "xpath"
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            },
            "match": {
              "type": "string",
              "enum": ["equals", "contains", "regex"],
              "default": "equals"
            }
          },
          "required": ["type", "text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "label"
            },
            "text": {
              "type": "string"
            }
          },
          "required": ["type", "text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "role"
            },
            "role": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": ["type", "role", "name"],
          "additionalProperties": false
        }
      ]
    }
  }
}
