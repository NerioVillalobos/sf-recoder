{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recorded Steps",
  "oneOf": [
    {
      "$ref": "#/definitions/plan"
    },
    {
      "$ref": "#/definitions/stepArray"
    }
  ],
  "definitions": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "number"
        },
        "meta": {
          "type": "object"
        },
        "start": {
          "$ref": "#/definitions/start"
        },
        "steps": {
          "$ref": "#/definitions/stepArray"
        }
      },
      "required": [
        "steps"
      ]
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retURL": {
          "type": "string"
        }
      }
    },
    "stepArray": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "click",
            "type",
            "wait"
          ]
        },
        "selector": {
          "$ref": "#/definitions/selector"
        },
        "value": {
          "type": "string"
        },
        "delay": {
          "type": "number"
        },
        "waitFor": {
          "$ref": "#/definitions/waitFor"
        },
        "ms": {
          "type": "number"
        },
        "timestamp": {
          "type": "number"
        }
      },
      "required": [
        "action"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "click"
              }
            }
          },
          "then": {
            "required": [
              "selector"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "type"
              }
            }
          },
          "then": {
            "required": [
              "selector",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "wait"
              }
            }
          },
          "then": {
            "required": [
              "waitFor"
            ]
          }
        }
      ]
    },
    "waitFor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "networkidle",
            "short",
            "dom"
          ]
        },
        "selector": {
          "$ref": "#/definitions/selector"
        },
        "ms": {
          "type": "number"
        }
      }
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "dataTestId"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "css"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "xpath"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            },
            "match": {
              "type": "string",
              "enum": [
                "equals",
                "contains",
                "regex"
              ]
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "label"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "role"
            },
            "role": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "role",
            "name"
          ]
        }
      ]
    }
  }
}
