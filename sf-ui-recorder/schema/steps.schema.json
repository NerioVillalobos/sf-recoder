{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Salesforce UI Plan",
  "oneOf": [
    { "$ref": "#/definitions/plan" },
    { "$ref": "#/definitions/stepsArray" }
  ],
  "definitions": {
    "plan": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "version": { "type": "number" },
        "meta": { "type": "object", "additionalProperties": true },
        "start": { "$ref": "#/definitions/start" },
        "steps": { "$ref": "#/definitions/stepsArray" }
      },
      "additionalProperties": false
    },
    "stepsArray": {
      "type": "array",
      "items": { "$ref": "#/definitions/step" }
    },
    "start": {
      "type": "object",
      "properties": {
        "retURL": { "type": "string" }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["click", "type", "wait"]
        },
        "selector": { "$ref": "#/definitions/selector" },
        "value": { "type": "string" },
        "delay": { "type": "number", "minimum": 0 },
        "waitFor": { "$ref": "#/definitions/waitFor" },
        "ms": { "type": "number", "minimum": 0 },
        "timestamp": { "type": "number" },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "action": { "const": "type" } }
          },
          "then": {
            "required": ["selector", "value"]
          }
        },
        {
          "if": {
            "properties": { "action": { "const": "click" } }
          },
          "then": {
            "required": ["selector"]
          }
        },
        {
          "if": {
            "properties": { "action": { "const": "wait" } }
          },
          "then": {
            "properties": { "selector": false },
            "required": []
          }
        }
      ],
      "additionalProperties": false
    },
    "waitFor": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["networkidle", "short", "dom"]
        },
        "selector": { "$ref": "#/definitions/selector" }
      },
      "additionalProperties": false
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "dataTestId" },
            "value": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "css" },
            "value": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "xpath" },
            "value": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string" },
            "match": {
              "type": "string",
              "enum": ["equals", "contains", "regex"],
              "default": "equals"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "label" },
            "text": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "role", "name"],
          "properties": {
            "type": { "const": "role" },
            "role": { "type": "string" },
            "name": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
